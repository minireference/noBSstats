19.4,  84.4, 109.6,\n       108.7,  84.7, 111.0,  92.1, 138.4, 105.2,  97.5, 115.9,\n       104.4, 105.6, 104.8, 110.8,  93.8, 106.6,  71.3, 130.6,\n       125.7, 130.2, 101.2, 109.0, 103.8,  96.7]","key":"NSXvW2cdKU"},{"type":"outputs","id":"JYqIXwrUEqR1c2pqJK9Qm","children":[],"key":"UugLDo4JxU"}],"identifier":"ff133e3d-8ca2-4a45-8bf7-0df99b3ae170","html_id":"ff133e3d-8ca2-4a45-8bf7-0df99b3ae170","key":"QdE43q8YKA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# data\n\ntreated = [92.69, 117.15, 124.79, 100.57, 104.27, 121.56, 104.18,\n           122.43, 98.85, 104.26, 118.56, 138.98, 101.33, 118.57, \n           123.37, 105.9, 121.75, 123.26, 118.58, 80.03, 121.15, \n           122.06, 112.31, 108.67, 75.44, 110.27, 115.25, 125.57,\n           114.57, 98.09, 91.15, 112.52, 100.12, 115.2, 95.32, \n           121.37, 100.09, 113.8, 101.73, 124.9, 87.83, 106.22, \n           99.97, 107.51, 83.99, 98.03, 71.91, 109.99, 90.83, 105.48]\n\ncontrols = [85.1, 84.05, 90.43, 115.92, 97.64, 116.41, 68.88, 110.51, \n            125.12, 94.04, 134.86, 85.0, 91.61, 69.95, 94.51, 81.16, \n            130.61, 108.93, 123.38, 127.69, 83.36, 76.97, 124.87, 86.36, \n            105.71, 93.01, 101.58, 93.58, 106.51, 91.67, 112.93, 88.74, \n            114.05, 80.32, 92.91, 85.34, 104.01, 91.47, 109.2, 104.04, \n            86.1, 91.52, 98.5, 94.62, 101.27, 107.41, 100.68, 114.94, \n            88.8, 121.8]\n","key":"yHWHyUrOBg"},{"type":"outputs","id":"m99nquRl7Ndm0yojBobgQ","children":[],"key":"R8JIfmQRud"}],"identifier":"1984bc59-319a-4291-8bfd-e89cb3e8e958","html_id":"1984bc59-319a-4291-8bfd-e89cb3e8e958","key":"bJqNDqIzUK"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Statistics procedures as readable code (ministats)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cXiGTHp3ap"}],"identifier":"statistics-procedures-as-readable-code-ministats","label":"Statistics procedures as readable code (ministats)","html_id":"statistics-procedures-as-readable-code-ministats","implicit":true,"key":"UFOenQeK9F"}],"identifier":"5a65a310-4bd4-4921-bd91-8c587f022edd","html_id":"5a65a310-4bd4-4921-bd91-8c587f022edd","key":"ujI5bruR3M"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Generating sampling distributions","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ogNLnjfNzy"}],"identifier":"generating-sampling-distributions","label":"Generating sampling distributions","html_id":"generating-sampling-distributions","implicit":true,"key":"NtLV1lZy7x"}],"identifier":"469e3e38-8aa7-4db7-b2c0-d297f9267738","html_id":"469e3e38-8aa7-4db7-b2c0-d297f9267738","key":"dJOdQB0lmf"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from ministats import gen_sampling_dist\n\n%psource gen_sampling_dist","key":"l16Q73FxNS"},{"type":"outputs","id":"mno9V2_sxqY9t29QXy9bN","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"\u001b[38;5;28;01mdef\u001b[39;00m gen_sampling_dist(rv, estfunc, n, N=\u001b[32m10000\u001b[39m):\n    \u001b[33m\"\"\"\u001b[39m\n\u001b[33m    Simulate `N` samples of size `n` from the random variable `rv`\u001b[39m\n\u001b[33m    to generate the sampling distribution of the estimator `estfunc`.\u001b[39m\n\u001b[33m    \"\"\"\u001b[39m\n    estimates = []\n    \u001b[38;5;28;01mfor\u001b[39;00m j \u001b[38;5;28;01min\u001b[39;00m range(N):\n        sample = rv.rvs(n)\n        estimate = estfunc(sample)\n        estimates.append(estimate)\n    \u001b[38;5;28;01mreturn\u001b[39;00m estimates\n","content_type":"text/plain"}}},"children":[],"key":"gYoi7Z2N5P"}],"key":"WBV7BSZaB4"}],"identifier":"a5d16f77-de61-41b3-b7be-3676490a1761","html_id":"a5d16f77-de61-41b3-b7be-3676490a1761","key":"cXagxwxTTA"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"One-sample t-test for the mean","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"tupJdkkiXF"}],"identifier":"one-sample-t-test-for-the-mean","label":"One-sample t-test for the mean","html_id":"one-sample-t-test-for-the-mean","implicit":true,"key":"i0gyM9S5h6"}],"identifier":"187859d1-146b-47a3-b41d-3573b47a4f6f","html_id":"187859d1-146b-47a3-b41d-3573b47a4f6f","key":"zuUJHfdGIg"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from ministats import ttest_mean\n%psource ttest_mean","key":"NbfT70M9Wl"},{"type":"outputs","id":"NppiuRuLjQWM4SGvmBKXw","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"\u001b[38;5;28;01mdef\u001b[39;00m ttest_mean(sample, mu0, alt=\u001b[33m\"two-sided\"\u001b[39m):\n    \u001b[33m\"\"\"\u001b[39m\n\u001b[33m    T-test to detect mean deviation from a population with known mean `mu0`.\u001b[39m\n\u001b[33m    \"\"\"\u001b[39m\n    \u001b[38;5;28;01massert\u001b[39;00m alt \u001b[38;5;28;01min\u001b[39;00m [\u001b[33m\"greater\"\u001b[39m, \u001b[33m\"less\"\u001b[39m, \u001b[33m\"two-sided\"\u001b[39m]\n    obsmean = np.mean(sample)\n    n = len(sample)\n    std = np.std(sample, ddof=\u001b[32m1\u001b[39m)\n    sehat = std / np.sqrt(n)\n    obst = (obsmean - mu0) / sehat\n    rvT = tdist(df=n-\u001b[32m1\u001b[39m)\n    pvalue = tailprobs(rvT, obst, alt=alt)\n    \u001b[38;5;28;01mreturn\u001b[39;00m pvalue\n","content_type":"text/plain"}}},"children":[],"key":"pnLIEVMDPm"}],"key":"zoWhVFpUdb"}],"identifier":"5e4ee9c7-d4d8-4e4e-b8dd-e78d684faefc","html_id":"5e4ee9c7-d4d8-4e4e-b8dd-e78d684faefc","key":"ObPTJaqZDQ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"ttest_mean(iqs, mu0=100, alt=\"greater\")","key":"gD1MzMMMkc"},{"type":"outputs","id":"qg7aK59vasm8Ia0nZJbw8","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":7,"metadata":{},"data":{"text/plain":{"content":"np.float64(0.01792942680682752)","content_type":"text/plain"}}},"children":[],"key":"HcGXvBVAMz"}],"key":"V1gLGTUvBT"}],"identifier":"2f9de151-7b27-4fee-8953-67a6be7e179c","html_id":"2f9de151-7b27-4fee-8953-67a6be7e179c","key":"OiBVzFe6qN"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Generating bootstrap distributions","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NRSjHjBNJI"}],"identifier":"generating-bootstrap-distributions","label":"Generating bootstrap distributions","html_id":"generating-bootstrap-distributions","implicit":true,"key":"IybX0CXfVJ"}],"identifier":"a412948b-486c-474d-866d-e8f37bf77574","html_id":"a412948b-486c-474d-866d-e8f37bf77574","key":"JOm00EXzLG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from ministats import gen_boot_dist\n\n%psource gen_boot_dist","key":"IReNTj6YPS"},{"type":"outputs","id":"B84TYlYcNiptom9kni2wX","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"\u001b[38;5;28;01mdef\u001b[39;00m gen_boot_dist(sample, estfunc, B=\u001b[32m5000\u001b[39m):\n    \u001b[33m\"\"\"\u001b[39m\n\u001b[33m    Generate estimates from the sampling distribution of the estimator `estfunc`\u001b[39m\n\u001b[33m    based on `B` bootstrap samples (sampling with replacement) from `sample`.\u001b[39m\n\u001b[33m    \"\"\"\u001b[39m\n    n = len(sample)\n    bestimates = []\n    \u001b[38;5;28;01mfor\u001b[39;00m j \u001b[38;5;28;01min\u001b[39;00m range(B):\n        bsample = np.random.choice(sample, n, replace=\u001b[38;5;28;01mTrue\u001b[39;00m)\n        bestimate = estfunc(bsample)\n        bestimates.append(bestimate)\n    \u001b[38;5;28;01mreturn\u001b[39;00m bestimates\n","content_type":"text/plain"}}},"children":[],"key":"rm2RXm8NFt"}],"key":"z3Z0rhhiEh"}],"identifier":"3d6a5bf0-1e61-4fe4-9111-45c7401a86b1","html_id":"3d6a5bf0-1e61-4fe4-9111-45c7401a86b1","key":"jGBoGQ8zR0"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\niqs_boot = gen_boot_dist(iqs, estfunc=np.mean)\nsns.histplot(iqs_boot);","key":"ostGOzKt2f"},{"type":"outputs","id":"wEHxU7CJxviisPqUvW6ww","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{"image/png":{"height":201,"width":622}},"data":{"image/png":{"content_type":"image/png","hash":"8e11e6ff6a92161756069cbde1d00bdd","path":"/build/8e11e6ff6a92161756069cbde1d00bdd.png"},"text/plain":{"content":"<Figure size 700x200 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"tlLjBGgAhz"}],"key":"GR1UVO4ycT"}],"identifier":"4a6bc2fa-2431-4ef8-9021-34d748a57e84","html_id":"4a6bc2fa-2431-4ef8-9021-34d748a57e84","key":"WC8rW7lEq8"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The permutation test for comparing two groups","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"EsiM8Axo3P"}],"identifier":"the-permutation-test-for-comparing-two-groups","label":"The permutation test for comparing two groups","html_id":"the-permutation-test-for-comparing-two-groups","implicit":true,"key":"dAGIaRL57r"}],"identifier":"e957746c-2d9f-4320-824e-77df7aa5499f","html_id":"e957746c-2d9f-4320-824e-77df7aa5499f","key":"bFWkWW8jVm"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from ministats.hypothesis_tests import resample_under_H0\nfrom ministats import permutation_test_dmeans\n\n%psource permutation_test_dmeans","key":"DV20MrY4iU"},{"type":"outputs","id":"ad0jc1FCs16mbPQAG2eUR","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"\u001b[38;5;28;01mdef\u001b[39;00m permutation_test_dmeans(xsample, ysample, P=\u001b[32m10000\u001b[39m):\n    \u001b[33m\"\"\"\u001b[39m\n\u001b[33m    Compute the p-value of the observed difference between means\u001b[39m\n\u001b[33m    `dmeans(xsample,ysample)` under the null hypothesis where\u001b[39m\n\u001b[33m    the group membership is randomized.\u001b[39m\n\u001b[33m    \"\"\"\u001b[39m\n    \u001b[38;5;66;03m# 1. Compute the observed difference between means\u001b[39;00m\n    obsdhat = dmeans(xsample, ysample)\n\n    \u001b[38;5;66;03m# 2. Get sampling dist. of `dmeans` under H0\u001b[39;00m\n    pdhats = []\n    \u001b[38;5;28;01mfor\u001b[39;00m i \u001b[38;5;28;01min\u001b[39;00m range(\u001b[32m0\u001b[39m, P):\n        rsx, rsy = resample_under_H0(xsample, ysample)\n        pdhat = dmeans(rsx, rsy)\n        pdhats.append(pdhat)\n\n    \u001b[38;5;66;03m# 3. Compute the p-value\u001b[39;00m\n    tails = tailvalues(pdhats, obsdhat)\n    pvalue = len(tails) / len(pdhats)\n    \u001b[38;5;28;01mreturn\u001b[39;00m pvalue\n","content_type":"text/plain"}}},"children":[],"key":"sc7VTFZ2uA"}],"key":"SbfmLbHfWx"}],"identifier":"72e9a742-bef0-4020-8c14-9c71e04b5f6b","html_id":"72e9a742-bef0-4020-8c14-9c71e04b5f6b","key":"ShRq4yMKwr"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"%psource resample_under_H0","key":"pjWRCmVY0l"},{"type":"outputs","id":"YmeAy855H_w33qEHYMofi","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"\u001b[38;5;28;01mdef\u001b[39;00m resample_under_H0(xsample, ysample):\n    \u001b[33m\"\"\"\u001b[39m\n\u001b[33m    Generate new samples from a random permutation of\u001b[39m\n\u001b[33m    the values in the samples `xsample` and `ysample`.\u001b[39m\n\u001b[33m    \"\"\"\u001b[39m\n    values = np.concatenate((xsample, ysample))\n    shuffled_values = np.random.permutation(values)\n    xresample = shuffled_values[\u001b[32m0\u001b[39m:len(xsample)]\n    yresample = shuffled_values[len(xsample):]\n    \u001b[38;5;28;01mreturn\u001b[39;00m xresample, yresample\n","content_type":"text/plain"}}},"children":[],"key":"vlRsw1bqkd"}],"key":"bPTn82io4N"}],"identifier":"08e64a3a-1974-40e9-9bab-9f21cb3855d3","html_id":"08e64a3a-1974-40e9-9bab-9f21cb3855d3","key":"xbHI7GPsIR"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"np.random.seed(43)\npermutation_test_dmeans(treated, controls)","key":"b1f6nAu8l1"},{"type":"outputs","id":"Lh8Adhl7bDEu7fp9Bm6-R","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":12,"metadata":{},"data":{"text/plain":{"content":"0.0098","content_type":"text/plain"}}},"children":[],"key":"LvZbZwNQvN"}],"key":"CwdTwCdH3f"}],"identifier":"72601f33-ab32-4958-9771-e8f1c11cc774","html_id":"72601f33-ab32-4958-9771-e8f1c11cc774","key":"reyr0Bz4oe"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"See the ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"tLl9j5aas0"},{"type":"link","url":"https://github.com/minireference/ministats/tree/main/ministats","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"inlineCode","value":"ministats","position":{"start":{"line":2,"column":1},"end