","children":[{"type":"code","lang":"python","executable":true,"value":"# sswg manual compute\ngmeans = data.mean(axis=1)\ndata_minus_gmeans = np.subtract(data.T, gmeans).T\n(data_minus_gmeans**2).sum()","key":"oPSAzYGrCH"},{"type":"outputs","id":"yyLieRIvoQo81rgeH_oL3","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":65,"metadata":{},"data":{"text/plain":{"content":"96.01507202947789","content_type":"text/plain"}}},"children":[],"key":"HGQ0mcBCxA"}],"key":"MLtyrXZav5"}],"identifier":"a5b87e0e-58fb-41df-bbb5-1b25981eb9f6","html_id":"a5b87e0e-58fb-41df-bbb5-1b25981eb9f6","key":"Rj9Bfs92bx"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# sswg via parallel axis thm\ngmeans = data.mean(axis=1)\nnp.sum( (data**2).sum(axis=1) - data.count(axis=1) * gmeans**2 )","key":"svlUKs62qX"},{"type":"outputs","id":"1QZW5pEcm-p7J2CbKgA8C","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":69,"metadata":{},"data":{"text/plain":{"content":"96.01507202947788","content_type":"text/plain"}}},"children":[],"key":"j0IAflvhf5"}],"key":"oUocqL0GTW"}],"identifier":"7190e9f5-75da-4276-9e64-054fa1f90bdd","html_id":"7190e9f5-75da-4276-9e64-054fa1f90bdd","key":"Z8dc2r5NAt"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from scipy.stats import f as fdist\n\ndef f_oneway(*args):\n    \"\"\"\n    Performs a 1-way ANOVA, returning an F-value and probability given\n    any number of groups.  From Heiman, pp.394-7.\n    \"\"\"\n    # Construct a single array of arguments: each row is a group\n    data = argstoarray(*args)\n    ngroups = len(data)\n    ntot = data.count()\n    sstot = (data**2).sum() - (data.sum())**2/float(ntot)\n    ssbg = (data.count(-1) * (data.mean(-1)-data.mean())**2).sum()\n    sswg = sstot-ssbg\n    print(ssbg, sswg, sstot)\n    dfbg = ngroups-1\n    dfwg = ntot - ngroups\n    msb = ssbg/float(dfbg)\n    msw = sswg/float(dfwg)\n    f = msb/msw\n    prob = fdist.sf(dfbg, dfwg, f)\n    return f, prob\n","key":"rGl3cJw5CF"},{"type":"outputs","id":"9ihxESZe61ZM5H8I3_30j","children":[],"key":"i8KaicaJMn"}],"identifier":"66e95cb3-7eb8-4085-9679-8ba4ad9a62fd","html_id":"66e95cb3-7eb8-4085-9679-8ba4ad9a62fd","key":"uehb5BL53h"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"f_oneway(x1.values, x2.values, x3.values, x4.values, x5.values)","key":"WAFhE1D1q3"},{"type":"outputs","id":"7Aa4pZP6_XVwu_oH8b51J","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"250.9402371658938 96.01507202947755 346.95530919537134\n"},"children":[],"key":"HaKsahE3OS"},{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":46,"metadata":{},"data":{"text/plain":{"content":"(62.07182379512513, 1.697371507321727e-08)","content_type":"text/plain"}}},"children":[],"key":"u1dOipGcq0"}],"key":"nKYJshFD57"}],"identifier":"f42c02af-e16c-4084-b3e2-7247aa775253","html_id":"f42c02af-e16c-4084-b3e2-7247aa775253","key":"PAQFvHlpdu"}],"key":"H8hpmCb9gD"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Welch’s two-sample t-test","url":"/examples/two-sample-t-test","group":"No Bullshit Guide to Statistics"},"next":{"title":"Two-sample equivalence test","url":"/examples/two-sample-equivalence-test","group":"No Bullshit Guide to Statistics"}}},"domain":"http://localhost:3000"}