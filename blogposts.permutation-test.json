b[0m\u001b[32;49m25.3\u001b[0m\n\u001b[1m[\u001b[0m\u001b[34;49mnotice\u001b[0m\u001b[1;39;49m]\u001b[0m\u001b[39;49m To update, run: \u001b[0m\u001b[32;49mpip install --upgrade pip\u001b[0m\nNote: you may need to restart the kernel to use updated packages.\n"},"children":[],"key":"XmxXAzj9VP"}],"key":"DyO41BLBrb"}],"identifier":"fee7a1de-830b-4e63-8a15-526bd95f30e9","html_id":"fee7a1de-830b-4e63-8a15-526bd95f30e9","key":"naMm0hrZCo"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Figures setup\nimport matplotlib.pyplot as plt\nimport seaborn as sns\n\nplt.clf()  # needed otherwise `sns.set_theme` doesn't work\nsns.set_theme(\n    style=\"whitegrid\",\n    rc={'figure.figsize': (7, 2)},\n)\n# High-resolution figures please\n%config InlineBackend.figure_format = 'retina'\n\nimport numpy as np\nnp.set_printoptions(legacy='1.25')\n\ndef savefig(fig, filename):\n    fig.tight_layout()\n    fig.savefig(filename, dpi=300, bbox_inches=\"tight\", pad_inches=0)","key":"DHd1Ul68bE"},{"type":"outputs","id":"1vSpIFYYAvjXI0a2ntES6","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 640x480 with 0 Axes>","content_type":"text/plain"}}},"children":[],"key":"Z38XYZALTt"}],"key":"wMEuhkkBIG"}],"identifier":"ad1db701-1cda-4156-b360-9a5ea8cd389d","html_id":"ad1db701-1cda-4156-b360-9a5ea8cd389d","key":"w7p3jz3ysa"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Introduction","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"nfWHld3n2F"}],"identifier":"introduction","label":"Introduction","html_id":"introduction","implicit":true,"key":"mQmqsjdIKi"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"p4p19jUVtb"},{"type":"emphasis","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"permutation tests","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"CKV6ptl0Kv"}],"key":"ARnwjUHJyl"},{"type":"text","value":" for comparing two groups is another example of the computational approach to statistics. The permutation test uses a randomization strategy on the data to generate samples from a hypothetical distribution that represents the “no difference between groups” scenario. The procedure of generating repeated samples from the “no difference” distribution is called a permutation test.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"r9CLmA0ixB"}],"key":"xaVb0AFZ61"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"The permutation test is an example of the hypothesis testing procedure. Classical statistics approaches the comparison of two groups by relying on pre-packaged procedures like the Welch’s two-sample t-test, which makes assumptions that the populations are normally distributed and uses complicated math formulas (analytical approximations). In contrast, the permutation test allows us to compare two groups without making assumptions about the populations’ distribution.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"q1p2vdq0BU"}],"key":"B3MW593gLQ"}],"identifier":"27a16fef-02c1-407c-abd4-bd5da286b9a3","html_id":"27a16fef-02c1-407c-abd4-bd5da286b9a3","key":"lxFdzsEzCW"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Statistical inference","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zBR2PXCaLH"}],"identifier":"statistical-inference","label":"Statistical inference","html_id":"statistical-inference","implicit":true,"key":"T7Q1ZzMJNY"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"TODO: improt short version from ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"iyxiaV6Akk"},{"type":"link","url":"/blogposts/simulation-hypothesis-tests","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"simulation​_hypothesis​_tests​.ipynb","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"VU3ZZaypgm"}],"urlSource":"./simulation_hypothesis_tests.ipynb","dataUrl":"/blogposts.simulation-hypothesis-tests.json","internal":true,"protocol":"file","key":"gk1OkBGHX8"}],"key":"kikEgqLhiM"}],"identifier":"a1d432a3-8f4f-4ae5-9203-c8b7881fd4c7","html_id":"a1d432a3-8f4f-4ae5-9203-c8b7881fd4c7","key":"RVzEz7oTGw"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Permutation test","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"h2eEtzaYdi"}],"identifier":"permutation-test","label":"Permutation test","html_id":"permutation-test","implicit":true,"key":"Ua1X8V0M6N"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"TODO: import from blog post and slides","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"mE8hADmUd4"}],"key":"Jm5wc04U2D"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Suppose we have a obtained samples from group of students who took the smart drug ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"sxvwHSWyft"},{"type":"inlineCode","value":"treated","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"J2xHD2PEOx"},{"type":"text","value":",\nand a similar group who didn’t take the smart drug ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"cUIYZRwlis"},{"type":"inlineCode","value":"controls","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"xQRLMEBUUw"},{"type":"text","value":".","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"Xr1YXULkfs"}],"key":"uAA4xIOVUv"}],"identifier":"4e9edf12-f2cd-41b8-ba1c-39bf21dc843d","html_id":"4e9edf12-f2cd-41b8-ba1c-39bf21dc843d","key":"NVfQ0zJYrl"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# data\n\ntreated = [92.69, 117.15, 124.79, 100.57, 104.27, 121.56, 104.18,\n           122.43, 98.85, 104.26, 118.56, 138.98, 101.33, 118.57, \n           123.37, 105.9, 121.75, 123.26, 118.58, 80.03, 121.15, \n           122.06, 112.31, 108.67, 75.44, 110.27, 115.25, 125.57,\n           114.57, 98.09, 91.15, 112.52, 100.12, 115.2, 95.32, \n           121.37, 100.09, 113.8, 101.73, 124.9, 87.83, 106.22, \n           99.97, 107.51, 83.99, 98.03, 71.91, 109.99, 90.83, 105.48]\n\ncontrols = [85.1, 84.05, 90.43, 115.92, 97.64, 116.41, 68.88, 110.51, \n            125.12, 94.04, 134.86, 85.0, 91.61, 69.95, 94.51, 81.16, \n            130.61, 108.93, 123.38, 127.69, 83.36, 76.97, 124.87, 86.36, \n            105.71, 93.01, 101.58, 93.58, 106.51, 91.67, 112.93, 88.74, \n            114.05, 80.32, 92.91, 85.34, 104.01, 91.47, 109.2, 104.04, \n            86.1, 91.52, 98.5, 94.62, 101.27, 107.41, 100.68, 114.94, \n            88.8, 121.8]\n","key":"UYIy4Wza6y"},{"type":"outputs","id":"Zouhb3R6wzF-ip6GA-nJn","children":[],"key":"wF7GT7yZie"}],"identifier":"9a157e15-7dfc-4d71-9c35-610d620189fa","html_id":"9a157e15-7dfc-4d71-9c35-610d620189fa","key":"tRYHu53GHw"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"We’ll compare the IQ scores in the two groups\nin terms of the difference between the average scores computed from each group.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"DiAn8kmzxB"}],"key":"k2RadnYUgu"}],"identifier":"71f5779e-485d-461b-a3e3-bb78acd8d903","html_id":"71f5779e-485d-461b-a3e3-bb78acd8d903","key":"ZEIUexQU8o"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def mean(sample):\n    return sum(sample) / len(sample)\n\ndef dmeans(xsample, ysample):\n    dhat = mean(xsample) - mean(ysample)\n    return dhat","key":"b6mFFb433z"},{"type":"outputs","id":"BbbNIaWgOE6yMON21uaDK","children":[],"key":"nVindlg124"}],"identifier":"e5a99093-b042-44d0-9e99-5657052316ed","html_id":"e5a99093-b042-44d0-9e99-5657052316ed","key":"XkcN4Fe0Vx"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Calculate the observed difference between means\ndscore = dmeans(treated, controls)\ndscore","key":"ImyhCR80rR"},{"type":"outputs","id":"PpXPXWfY8-Pi7gOTjKDee","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":5,"metadata":{},"data":{"text/plain":{"content":"7.8870000000000005","content_type":"text/plain"}}},"children":[],"key":"EYCM1vHIpZ"}],"key":"tXHsRc6xWf"}],"identifier":"09422e6f-4b18-4c9d-b9b6-749f3fb8bd44","html_id":"09422e6f-4b18-4c9d-b9b6-749f3fb8bd44","key":"lrpSzqp8ia"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Statistical question?","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"D0BqkufhqQ"}],"identifier":"statistical-question","label":"Statistical question?","html_id":"statistical-question","implicit":true,"key":"CGGW3kdKfP"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Are the two groups the same?\nThis is equivalent to saying the smart drug had no effect.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"DDG2WvDFgF"}],"key":"ob1ef59dhi"}],"identifier":"bddb09fa-fe36-4927-a478-64e634f82513","html_id":"bddb09fa-fe36-4927-a478-64e634f82513","key":"fhkwlfivVF"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Disproving the skeptical colleague","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"XfE1yI0Skk"}],"identifier":"disproving-the-skeptical-colleague","label":"Disproving the skeptical colleague","html_id":"disproving-the-skeptical-colleague","implicit":true,"key":"YBnxyrHrHD"}],"identifier":"d35564e3-1873-42da-935e-350583bbee7c","html_id":"d35564e3-1873-42da-935e-350583bbee7c","key":"v4PqGHnS6o"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"We’ll now use the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yosX3DZ9Cs"},{"type":"inlineCode","value":"10000","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Cp56qTW69H"},{"type":"text","value":" permutations of the original data\nto obtain sampling distribution of the difference between means under the null hypothesis.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"iq9PKTviF1"}],"key":"T9j12urAbQ"}],"identifier":"0498fecb-412a-4d22-8379-e526681c95ba","html_id":"0498fecb-412a-4d22-8379-e526681c95ba","key":"edDD9bmh10"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nnp.random.seed(43)\n\npdhats = []\nfor i in range(0, 10000):\n    all_iqs = np.concatenate((treated, controls))\n    pall_iqs = np.random.permutation(all_iqs)\n    ptreated = pall_iqs[0:len(treated)]\n    pcontrols = pall_iqs[len(treated):]\n    pdhat = dmeans(ptreated, pcontrols)\n    pdhats.append(pdhat)","key":"PKgaSBMa2Q"},{"type":"outputs","id":"_WiWwrboS1XVsEW2OlMGl","children":[],"key":"xyQ2xh2TiM"}],"identifier":"d795c62d-5188-4169-a307-ee195dc5935b","html_id":"d795c62d-5188-4169-a307-ee195dc5935b","key":"J3S0sCCEg7"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Compute the p-value of the observed difference between means ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Fnq63BnmAP"},{"type":"inlineCode","value":"dscore","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gmX7GfS43F"},{"type":"text","value":" under the null hypothesis.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Ctea2wKqgl"}],"key":"VoQoIKpA97"}],"identifier":"0d0f575f-7e85-426b-b53d-50dda13439ef","html_id":"0d0f575f-7e85-426b-b53d-50dda13439ef","key":"n1Fibl3hHm"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"tails = [d for d in pdhats if abs(d) > dscore]\npvalue = len(tails) / len(pdhats)\npvalue","key":"AxugtPoFhp"},{"type":"outputs","id":"Z4JNPKak1ffyrC5Edr7wK","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":7,"metadata":{},"data":{"text/plain":{"content":"0.0101","content_type":"text/plain"}}},"children":[],"key":"Vu3KfSSvHH"}],"key":"beuiu72v21"}],"identifier":"03fd9b23-27fb-4e49-ae85-71b2e0dae38b","html_id":"03fd9b23-27fb-4e49-ae85-71b2e0dae38b","key":"JGUx9V98b5"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"bins = np.arange(-11, 11, 0.3)\n\n# plot the sampling distribution in blue\nax = sns.histplot(pdhats, bins=bins)\n\n# plot red line for the observed statistic\nplt.axvline(dscore, color=\"red\")\n\n# plot the values that are equal or more extreme in red\nsns.histplot(tails, ax=ax, bins=bins, color=\"red\")\nax.set_xlabel(\"$d$\")\nax.set_ylabel(\"$f_{D}$\")\n\nsavefig(plt.gcf(), \"figures/pvalue_viz_permutation_test_iqs.png\")","key":"suZKSnM5e2"},{"type":"outputs","id":"UyadXLDM4kImFQwb1urIK","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{"image/png":{"height":182,"width":680}},"data":{"image/png":{"content_type":"image/png","hash":"01e574a2144acbd5c74da92014fa3f1f","path":"/build/01e574a2144acbd5c74da92014fa3f1f.png"},"text/plain":{"content":"<Figure size 700x200 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"XrHtlkIlTA"}],"key":"fbVCrmN9qq"}],"identifier":"2fb93271-0379-4017-94b1-4846dfbd9b0c","html_id":"2fb93271-0379-4017-94b1-4846dfbd9b0c","key":"xzS0uXzK04"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":4,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Alternative using formula","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"OluQYYmJ2g"}],"identifier":"alternative-using-formula","label":"Alternative using formula","html_id":"alternative-using-formula","implicit":true,"key":"YE4WBnDtI0"}],"identifier":"28e2a3be-5300-469c-a4b6-ef628a93c1d2","html_id":"28e2a3be-5300-469c-a4b6-ef628a93c1d2","key":"hjjBViwA4V"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from ministats import ttest_dmeans\nttest_dmeans(treated, controls)","key":"R9kzsNXJmu"},{"type":"outputs","id":"CKTaZqqvdHC1H5KpFJARf","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":9,"metadata":{},"data":{"text/plain":{"content":"0.010163611652137501","content_type":"text/plain"}}},"children":[],"key":"yBL0USe92E"}],"key":"F3CJvulA2D"}],"identifier":"b2637fd3-b57c-45c0-8806-6e4da72ec508","html_id":"b2637fd3-b57c-45c0-8806-6e4da72ec508","key":"AHFZolirPY"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":4,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Alternative using predefined function","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"HAIGbXcGuv"}],"identifier":"alternative-using-predefined-function","label":"Alternative using predefined function","html_id":"alternative-using-predefined-function","implicit":true,"key":"iBn6T4oH6a"}],"identifier":"b0007220-df27-4806-8029-f12640e28a6a","html_id":"b0007220-df27-4806-8029-f12640e28a6a","key":"EUD4axmgN8"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from scipy.stats import permutation_test\n\nres = permutation_test([treated, controls], statistic=dmeans)\nres.statistic, res.pvalue","key":"iaaabOicri"},{"type":"outputs","id":"qBO_JuGocxyh-IZXdsGQo","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":10,"metadata":{},"data":{"text/plain":{"content":"(7.886999999999972, 0.0108)","content_type":"text/plain"}}},"children":[],"key":"CQc1Jj7ZFR"}],"key":"mZvSGNemQf"}],"identifier":"51fb23e8-3a7b-4eea-97f5-bdd122e1c62d","html_id":"51fb23e8-3a7b-4eea-97f5-bdd122e1c62d","key":"a9mSyeXFru"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Conclusion","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dL1sMcbtSJ"}],"identifier":"conclusion","label":"Conclusion","